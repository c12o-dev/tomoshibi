---
import type { GetStaticPaths } from 'astro'
import TechStack from '../../components/TechStack.astro'
import { projects } from '../../data/projects'
import { ui } from '../../data/site'
import type { Project } from '../../data/types'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = (() =>
  projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[index - 1],
      next: projects[index + 1],
    },
  }))) satisfies GetStaticPaths

interface Props {
  project: Project
  prev?: Project
  next?: Project
}

const { project, prev, next } = Astro.props
const labels = ui.project
---

<Base title={project.title} description={project.summary}>
  <article class="container">
    <nav class="breadcrumb mono-label" aria-label={labels.breadcrumbAria}>
      <a href="/">{labels.home}</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href="/#projects">{labels.projects}</a>
    </nav>

    <header class="page-head">
      <span class="mono-label is-accent">{project.status} · {project.kind}</span>
      <h1 class="t-h1">{project.title}</h1>
      <p class="t-lead">{project.summary}</p>
      <a class="btn btn--primary" href={project.link.href} target="_blank" rel="noopener">
        {project.link.label}
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </header>

    <figure class="cover grain">
      <img
        id={`cover-${project.slug}`}
        src={project.screenshot.src}
        alt={project.screenshot.alt}
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <div class="detail measure">
      <section class="detail__block" aria-labelledby="why-title">
        <h2 class="t-h3" id="why-title">{labels.why}</h2>
        {project.why.map((paragraph) => <p class="prose">{paragraph}</p>)}
      </section>

      <section class="detail__block" aria-labelledby="decisions-title">
        <h2 class="t-h3" id="decisions-title">{labels.decisions}</h2>
        {project.decisions.map((paragraph) => <p class="prose">{paragraph}</p>)}
      </section>

      <section class="detail__block" aria-labelledby="stack-title">
        <h2 class="t-h3" id="stack-title">{labels.stack}</h2>
        <TechStack groups={project.techGroups} />
      </section>
    </div>

    <nav class="post-nav" aria-label={labels.otherAria}>
      {
        prev ? (
          <a class="post-nav__item" href={`/projects/${prev.slug}/`}>
            <span class="mono-label">{labels.prev}</span>
            <span class="post-nav__title">{prev.title}</span>
          </a>
        ) : (
          <a class="post-nav__item" href="/#projects">
            <span class="mono-label">{labels.backToList}</span>
            <span class="post-nav__title">{labels.listTitle}</span>
          </a>
        )
      }
      {
        next ? (
          <a class="post-nav__item is-next" href={`/projects/${next.slug}/`}>
            <span class="mono-label">{labels.next}</span>
            <span class="post-nav__title">{next.title}</span>
          </a>
        ) : (
          <a class="post-nav__item is-next" href="/#projects">
            <span class="mono-label">{labels.toList}</span>
            <span class="post-nav__title">{labels.listTitle}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
