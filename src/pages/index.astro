---
import About from '../components/About.astro'
import Contact from '../components/Contact.astro'
import Hero from '../components/Hero.astro'
import LatestPosts from '../components/LatestPosts.astro'
import Projects from '../components/Projects.astro'
import { site } from '../data/site'
import Base from '../layouts/Base.astro'

// Search-engine metadata only; browsers never execute ld+json.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.person.name,
  ...(site.person.alternateName && { alternateName: site.person.alternateName }),
  url: Astro.site?.href,
  ...(site.person.jobTitle && { jobTitle: site.person.jobTitle }),
  sameAs: Object.values(site.links).filter(Boolean),
})
---

<Base>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <div class="container">
    <Hero />
    <Projects />
    <LatestPosts />
    <About />
    <Contact />
  </div>
</Base>
