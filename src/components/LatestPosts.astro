---
import { site, ui } from '../data/site'
import { fetchLatestPosts } from '../lib/blog-feed'

// Build-time fetch. No feed URL, a feed that is down, or an offline build all
// give an empty list, and the section is not rendered.
const posts = site.feedUrl ? await fetchLatestPosts(site.feedUrl, 5) : []
const viewAllHref = site.links.blog ?? (site.feedUrl ? new URL(site.feedUrl).origin : undefined)
---

{
  posts.length > 0 && (
    <section class="section" id="posts" aria-labelledby="posts-title">
      <div class="section-head">
        <div class="section-head__title">
          <span class="mono-label is-accent">{ui.posts.eyebrow}</span>
          <h2 class="t-h2" id="posts-title">{ui.posts.heading}</h2>
        </div>
        {viewAllHref && (
          <a class="more-link" href={viewAllHref} target="_blank" rel="noopener">
            {ui.posts.viewAll}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        )}
      </div>

      <ul class="row-list">
        {posts.map((post) => (
          <li>
            <a class="row-link" href={post.href} target="_blank" rel="noopener">
              <time class="mono-label" datetime={post.date.replaceAll('.', '-')}>
                {post.date}
              </time>
              <span class="row-link__title">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
