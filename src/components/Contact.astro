---
import { contact, site, ui } from '../data/site'
---

<section class="contact grain" id="contact" aria-labelledby="contact-title">
  <div class="contact__text">
    <span class="mono-label is-accent">{ui.contact.eyebrow}</span>
    <h2 class="t-h2" id="contact-title">{contact.heading}</h2>
    {contact.note && <span class="mono-label">{contact.note}</span>}
  </div>
  <a class="btn btn--primary" href={`mailto:${site.email}`}>
    {site.email}
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</section>
