---
import type { TechGroup } from '../data/types'

interface Props {
  groups: readonly TechGroup[]
}

const { groups } = Astro.props
---

<dl class="rows">
  {
    groups.map((group) => (
      <div>
        <dt class="mono-label">{group.label}</dt>
        <dd class="pills">
          {group.items.map((item) => (
            <span class="pill">{item}</span>
          ))}
        </dd>
      </div>
    ))
  }
</dl>
