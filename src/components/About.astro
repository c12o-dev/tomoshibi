---
import { about, ui } from '../data/site'
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="section-head">
    <div class="section-head__title">
      <span class="mono-label is-accent">{ui.about.eyebrow}</span>
      <h2 class="t-h2" id="about-title">{ui.about.heading}</h2>
    </div>
  </div>

  <div class="about">
    <div class="about__text">
      <div class="stack">
        {about.lead.map((paragraph) => <p class="prose">{paragraph}</p>)}
      </div>

      {
        about.next.length > 0 && (
          <div class="stack">
            <h3 class="t-h3">{ui.about.nextHeading}</h3>
            <ul class="rows">
              {about.next.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <dl class="rows about__facts">
      {
        about.facts.map((fact) => (
          <div>
            <dt class="mono-label">{fact.label}</dt>
            <dd class="pills">
              {fact.items.map((item) => (
                <span class="pill">{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
