---
import { projects } from '../data/projects'
import { ui } from '../data/site'
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="section-head">
    <div class="section-head__title">
      <span class="mono-label is-accent">{ui.projects.eyebrow} · {projects.length}</span>
      <h2 class="t-h2" id="projects-title">{ui.projects.heading}</h2>
    </div>
  </div>

  <div class="project-grid">
    {
      projects.map((project, index) => (
        <article class="card grain">
          <div class="card__cover">
            <img
              id={`cover-${project.slug}`}
              src={project.screenshot.src}
              alt={project.screenshot.alt}
              width="1600"
              height="900"
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
          <div class="card__body">
            <span class="mono-label">
              {project.status} · {project.kind}
            </span>
            <h3 class="card__title t-title-card">
              <a href={`/projects/${project.slug}/`}>{project.title}</a>
            </h3>
            <p class="card__summary t-small clamp-2">{project.summary}</p>
            <div class="card__foot pills">
              {project.tech.map((tech) => (
                <span class="pill">{tech}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
