---
import { footer, site, ui } from '../data/site'

const year = new Date().getFullYear()

// Only the links that are set in site.links are shown.
const LINK_LABELS: Record<keyof typeof site.links, string> = {
  blog: 'Blog',
  github: 'GitHub',
  x: 'X',
}
const links = (Object.keys(LINK_LABELS) as (keyof typeof site.links)[])
  .filter((key) => site.links[key])
  .map((key) => ({ label: LINK_LABELS[key], href: site.links[key] as string }))
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__row">
      <div class="site-footer__brand">
        <a class="wordmark" href="/">
          <span class="wordmark__dot" aria-hidden="true"></span>
          {site.name}
        </a>
        <span>{footer.tagline}</span>
      </div>
      {
        links.length > 0 && (
          <nav class="site-footer__links" aria-label={ui.footer.navAria}>
            {links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener">
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>
    <p class="mono-label site-footer__meta">
      © {year} {site.author} · {ui.footer.builtWith}
    </p>
  </div>
</footer>
